pragma solidity ^0.8.20;
interface IERC20 {
function transferFrom(address sender, address recipient, uint256 amount) external returns (bool);
function transfer(address recipient, uint256 amount) external returns (bool);
}
/
￼ @title EscrowP2POffChain
￼ @dev Smart Contract de Escrow P2P com suporte a ordens pré-assinadas via EIP-712 sem gás inicial na Polygon.
*/
contract EscrowP2POffChain {
address public admin;
IERC20 public usdcToken;
// Taxa da aplicação em pontos base (Ex: 100 = 1%)
uint256 public taxaAplicacao = 100;
uint256 public constant BASE_PORCENTAGEM = 10000;
// Definição das estruturas do EIP-712
bytes32 public constant EIP712_DOMAIN_TYPEHASH =
keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");
bytes32 public constant ORDEM_TYPEHASH =
keccak256("Ordem(address criador,uint256 valorUSDC,uint256 cotacao,uint256 nonce,uint256 expiracao)");
bytes32 public DOMAIN_SEPARATOR;
// Mapeamento para controle de nonces e evitar Replay Attacks
mapping(address => mapping(uint256 => bool)) public nonceUtilizado;
event OrdemExecutada(bytes32 indexed hashOrdem, address indexed criador, address indexed comprador, uint256 valorUSDC, uint256 taxaColetada);
event OrdemCancelada(address indexed criador, uint256 indexed nonce);
modifier apenasAdmin() {
require(msg.sender == admin, "Apenas o administrador pode executar esta acao");
_;
}
constructor(address _usdcToken, address _admin) {
require(_usdcToken != address(0), "Endereco USDC invalido");
require(_admin != address(0), "Endereco Admin invalido");
usdcToken = IERC20(_usdcToken);
admin = _admin;
DOMAIN_SEPARATOR = keccak256(
abi.encode(
EIP712_DOMAIN_TYPEHASH,
keccak256(bytes("CarteiraBRN_P2P")),
keccak256(bytes("1")),
block.chainid,
address(this)
)
);
}
struct Ordem {
address payable criador;
uint256 valorUSDC;
uint256 cotacao;
uint256 nonce;
uint256 expiracao;
}
// Extrai o endereço público do assinante usando a chave pública
function getSigner(Ordem memory _ordem, bytes memory _assinatura) public view returns (address) {
bytes32 structHash = keccak256(
abi.encode(
ORDEM_TYPEHASH,
_ordem.criador,
_ordem.valorUSDC,
_ordem.cotacao,
_ordem.nonce,
_ordem.expiracao
)
);
bytes32 digest = keccak256(abi.encodePacked("\x19\x01", DOMAIN_SEPARATOR, structHash));
return recoverSigner(digest, _assinatura);
}
// Valida e liquida a ordem pré-assinada na Polygon
function executarOrdem(
Ordem memory _ordem,
bytes memory _assinatura,
address payable _comprador
) external {
require(block.timestamp <= _ordem.expiracao, "A ordem expirou");
require(!nonceUtilizado[_ordem.criador][_ordem.nonce], "Ordem ja executada ou cancelada");
address assinadoPor = getSigner(_ordem, _assinatura);
require(assinadoPor == _ordem.criador, "Assinatura invalida para este criador");
nonceUtilizado[_ordem.criador][_ordem.nonce] = true;
uint256 valorTaxa = (_ordem.valorUSDC * taxaAplicacao) / BASE_PORCENTAGEM;
uint256 valorLiquidoComprador = _ordem.valorUSDC - valorTaxa;
require(usdcToken.transferFrom(_ordem.criador, _comprador, valorLiquidoComprador), "Falha na transferencia para comprador");
if (valorTaxa > 0) {
require(usdcToken.transferFrom(_ordem.criador, admin, valorTaxa), "Falha no recolhimento da taxa");
}
emit OrdemExecutada(keccak256(_assinatura), _ordem.criador, _comprador, _ordem.valorUSDC, valorTaxa);
}
// Permite ao criador cancelar o nonce off-chain diretamente na blockchain
function cancelarOrdem(uint256 _nonce) external {
nonceUtilizado[msg.sender][_nonce] = true;
emit OrdemCancelada(msg.sender, _nonce);
}
// Atualiza taxa da aplicação (máximo 5%)
function alterarTaxa(uint256 _novaTaxa) external apenasAdmin {
require(_novaTaxa <= 500, "Taxa nao pode exceder 5%");
taxaAplicacao = _novaTaxa;
}
}
function recoverSigner(bytes32 _digest, bytes memory _sig) pure returns (address) {
require(_sig.length == 65, "Comprimento de assinatura invalido");
bytes32 r;
bytes32 s;
uint8 v;
assembly {
r := mload(add(_sig, 32))
s := mload(add(_sig, 64))
v := byte(0, mload(add(_sig, 96)))
}
return ecrecover(_digest, v, r, s);
}